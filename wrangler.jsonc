// Configuración de Cloudflare (Workers con archivos estáticos).
// Solo se publica la carpeta public/. Nada más del repositorio (README, .git, etc.) sale a internet.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ajudaescolar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
