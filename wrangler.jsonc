// Configuración de Cloudflare (Workers con archivos estáticos).
// Solo se publica la carpeta public/. Nada más del repositorio (README, .git, etc.) sale a internet.
// src/worker.js atiende solo /api/* (registro del taller); todo lo demás son los archivos de public/.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ajudaescolar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REGISTRE", "class_name": "Registre" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Registre"] }
  ],
  "workers_dev": true,
  "preview_urls": false
}
